# Tiger AI Gateway Configuration (Provide your private key in .env, never commit .env)
TIGER_AI_GATEWAY_URL=https://ai-gateway.tigeranalytics.in/v1
TIGER_AI_GATEWAY_KEY=your_tiger_ai_gateway_api_key_here
USER_EMAIL=shashank.chebrolu@tigeranalytics.com
PROJECT_ID=retail-agentic-ai-l2
TIGER_MODEL_NAME=gemini-2.0-flash

# MySQL Database Configuration (Managed via MySQL Workbench)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password_here
MYSQL_DATABASE=retail_db

# Agent Safety Controls
ALLOW_MUTATING_SQL=false
MAX_SQL_ROW_LIMIT=50
